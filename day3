//the below code uses the BMI Calculator from yesterday along with some if, elif and else statements to give interpretations.
height = float(input("What is your height in m?"))
weight = float(input("What is your weight in kg?"))

bmi = weight/(height ** 2)
bmi_rounded = round(bmi, 2)
print("Your BMI is " + str(bmi_rounded))

if bmi_rounded <18.5:
    print("You are underweight!")
elif bmi_rounded >=18.5 and bmi_rounded < 25:
    print ("You are of a normal weight!")
else:
    print ("You are overweight! :(")

//the below code is a pizza ordering system that increases the price of the bill as different components are added
size = input("What size pizza do you want? S, M or L: ")
pepperoni = input("Do you want pepperoni on your pizza? Y or N: ")
extra_cheese = input("Do you want extra cheese? Y or N: ")


bill = 0

if size == "S":
    bill += 15
elif size == "M":
    bill += 20
elif size == "L":
    bill += 25
else:
    print("You have chosen an invalid size.")

if pepperoni == "Y":
    if size == "S":
        bill += 2
    else:
        bill += 3

if extra_cheese == "Y":
    bill += 1

print(f"Your final bill is: ${bill}.")
