//Below is an even number checker

number = int(input ("Pick a whole number:")) //asks for input of a whole number and converts the output to an int
if number % 2 == 0: // if the remainder after dividing by 2 = 0 number is even
    print ("Your number is even!")
else: // if it isn't number is odd
    print("Your number is odd!")

